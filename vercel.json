{
  "version": 2,
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/tmdb/:path*",
      "destination": "/api/tmdb/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
