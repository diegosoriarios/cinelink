# CineLink environment variables
# Copy this file to `.env` for local development.
# For Expo, only variables prefixed with EXPO_PUBLIC_ are available in the client bundle.

# Direct TMDB API key. This is the primary way the app talks to TMDB: whenever it is
# set, requests go straight to https://api.themoviedb.org and never touch a backend.
# Recommended for local dev, native, and web.
# Note: on web this key is visible in the JS bundle (it's a client-side key).
# Get a key from: https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Optional TMDB proxy base URL. Used ONLY when EXPO_PUBLIC_TMDB_API_KEY is not set,
# as a fallback that keeps the key server-side. The Node server (server/, deployed on
# Render) and the web app's Vercel function both serve a /tmdb/* proxy.
# - If set, requests go to: ${EXPO_PUBLIC_TMDB_PROXY_URL}/tmdb/*
# - On web with no key and no proxy, the app uses its own origin (/tmdb/*).
# Example (Render): https://cinelink-server.onrender.com
EXPO_PUBLIC_TMDB_PROXY_URL=

# CineLink server base URL for the realtime race API (multiplayer only).
# Not needed for single-player (daily / explorer / speedrun).
# Usually the same host as the Render server used for the TMDB proxy.
# Example: https://cinelink-server.onrender.com
EXPO_PUBLIC_RACE_URL=

# Optional public app URL used in web metadata and sharing contexts
# Example: https://cinelink.vercel.app
EXPO_PUBLIC_APP_URL=

# Poster background dataset generator (run: npm run generate:posters)
# Uses TMDB_API_KEY if set, otherwise falls back to EXPO_PUBLIC_TMDB_API_KEY above.
# TMDB_API_KEY=your_tmdb_api_key_here

# ----------------------------------------------------------------------
# CineLink server deployment notes (NOT used by Expo client directly)
# ----------------------------------------------------------------------
# The server reads this secret at runtime:
#   TMDB_API_KEY=your_tmdb_api_key_here
#
# Local development:
#   1. cp .env.example .env
#   2. npm run dev:server   (listens on http://localhost:8787)
#
# Production (Render):
#   render.yaml blueprint included — create a Blueprint instance from the
#   Render dashboard and set the TMDB_API_KEY env var when prompted.
