# CineLink environment variables
# Copy this file to `.env` for local development.
# For Expo, only variables prefixed with EXPO_PUBLIC_ are available in the client bundle.

# Direct TMDB API key (client-side)
# Use this for local MVP/testing if you are not using the proxy.
# Get a key from: https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Optional Cloudflare Worker proxy base URL (recommended for production)
# If set, the app sends requests to: ${EXPO_PUBLIC_TMDB_PROXY_URL}/tmdb/*
# Example: https://cinelink-tmdb-proxy.your-subdomain.workers.dev
EXPO_PUBLIC_TMDB_PROXY_URL=

# Optional public app URL used in web metadata and sharing contexts
# Example: https://cinelink.vercel.app
EXPO_PUBLIC_APP_URL=

# ----------------------------------------------------------------------
# Cloudflare Worker deployment notes (NOT used by Expo client directly)
# ----------------------------------------------------------------------
# In your Cloudflare Worker, create this secret:
#   TMDB_API_KEY=your_tmdb_api_key_here
#
# Example command:
#   wrangler secret put TMDB_API_KEY
#
# Worker script path in this project:
#   worker/tmdb-proxy.js
#
# After deploying worker, set EXPO_PUBLIC_TMDB_PROXY_URL above.
